{
  "name": "wallarm-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "A comprehensive design system and component library for Wallarm",
  "license": "MIT",
  "author": "Wallarm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallarm/design-system.git"
  },
  "scripts": {
    "build": "turbo run build",
    "build:configs": "pnpm --filter=\"./packages/configs/*\" build",
    "dev": "turbo run dev",
    "storybook": "turbo run storybook",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "format": "oxfmt --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:run": "turbo run test:run",
    "e2e": "turbo run e2e",
    "e2e:ui": "turbo run e2e:ui",
    "e2e:report": "turbo run e2e:report",
    "e2e:docker:report": "echo '📊 Starting Docker E2E reports on ports 9323 (Design System) and 9324 (Playground)' && turbo run e2e:docker:report",
    "e2e:docker:report:design-system": "pnpm --filter=@wallarm-org/design-system e2e:docker:report",
    "e2e:local": "./scripts/e2e-docker.sh",
    "e2e:local:design-system": "./scripts/e2e-docker.sh design-system",
    "e2e:docker": "./scripts/e2e-docker.sh --docker",
    "e2e:docker:design-system": "./scripts/e2e-docker.sh --docker design-system",
    "e2e:docker:update": "./scripts/e2e-docker.sh --docker --update",
    "e2e:docker:update:design-system": "./scripts/e2e-docker.sh --docker --update design-system",
    "e2e:failed": "./scripts/e2e-docker.sh --failed",
    "e2e:failed:design-system": "./scripts/e2e-docker.sh --failed design-system",
    "e2e:docker:failed": "./scripts/e2e-docker.sh --docker --failed",
    "e2e:docker:failed:design-system": "./scripts/e2e-docker.sh --docker --failed design-system",
    "clean": "pnpm -r exec rm -rf node_modules dist coverage .turbo test-results playwright-report test-results storybook-static && rm -rf node_modules .turbo",
    "commit": "cz",
    "semantic-release": "semantic-release",
    "semantic-release:dry-run": "semantic-release --dry-run",
    "prepare": "husky",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "catalog:",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "catalog:",
    "commitizen": "4.3.2",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "semantic-release": "25.0.9",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "maxHeaderWidth": 100,
      "maxLineWidth": 100,
      "defaultType": "feat",
      "defaultScope": "",
      "defaultSubject": "",
      "defaultBody": "",
      "types": {
        "feat": {
          "description": "A new feature",
          "title": "Features"
        },
        "fix": {
          "description": "A bug fix",
          "title": "Bug Fixes"
        },
        "docs": {
          "description": "Documentation only changes",
          "title": "Documentation"
        },
        "style": {
          "description": "Changes that do not affect the meaning of the code",
          "title": "Styles"
        },
        "refactor": {
          "description": "A code change that neither fixes a bug nor adds a feature",
          "title": "Code Refactoring"
        },
        "perf": {
          "description": "A code change that improves performance",
          "title": "Performance Improvements"
        },
        "test": {
          "description": "Adding missing tests or correcting existing tests",
          "title": "Tests"
        },
        "build": {
          "description": "Changes that affect the build system or external dependencies",
          "title": "Build System"
        },
        "ci": {
          "description": "Changes to our CI configuration files and scripts",
          "title": "Continuous Integration"
        },
        "chore": {
          "description": "Other changes that don't modify src or test files",
          "title": "Chores"
        },
        "revert": {
          "description": "Reverts a previous commit",
          "title": "Reverts"
        }
      }
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "hono": ">=4.13.11",
      "@hono/node-server": ">=1.19.14 <2.0.0",
      "express-rate-limit": ">=8.2.2",
      "path-to-regexp": ">=8.4.0",
      "fast-uri": ">=3.1.8 <4.0.0",
      "ip-address": ">=10.7.1",
      "ajv": ">=8.20.0",
      "qs": ">=6.16.0",
      "rollup": ">=4.62.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.5",
      "ws": ">=8.21.0",
      "postcss": ">=8.5.28",
      "@types/react": "19.3.0",
      "@storybook/react": "10.6.2",
      "@storybook/react-dom-shim": "10.6.2",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "undici@<6.28.1": "^6.28.1",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "engine.io@>=6.6.0 <6.6.10": "^6.6.10",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "proxy-addr@<2.0.8": "^2.0.8",
      "shell-quote@<1.11.0": "^1.11.0",
      "handlebars@<4.7.10": "^4.7.10",
      "launch-editor@<2.14.2": "^2.14.2"
    }
  }
}
