{
  "name": "@wallarm-org/design-system",
  "version": "2.0.0",
  "description": "Core design system library with React components and Storybook documentation",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallarm/design-system.git",
    "directory": "packages/design-system"
  },
  "license": "MIT",
  "author": "Wallarm",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons": {
      "development": "./src/icons/index.ts",
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "require": "./dist/icons/index.js",
      "default": "./dist/icons/index.js"
    },
    "./theme": {
      "development": "./src/theme/index.css",
      "import": "./dist/theme/index.css",
      "require": "./dist/theme/index.css",
      "default": "./dist/theme/index.css"
    },
    "./metadata": {
      "import": "./dist/metadata/components.json",
      "require": "./dist/metadata/components.json",
      "default": "./dist/metadata/components.json"
    },
    "./utils/*": {
      "development": "./src/utils/*.ts",
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    },
    "./*": {
      "development": "./src/components/*/index.ts",
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "require": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rslib build && pnpm generate-metadata",
    "generate-metadata": "tsx scripts/metadata/generate.ts",
    "build:watch": "rslib build --watch",
    "prepublishOnly": "prepare-publish",
    "postpublish": "restore-package",
    "generate-exports": "tsx scripts/generate-exports.ts",
    "compiler:audit": "tsx scripts/compiler-audit.ts",
    "generate:grammars": "lezer-generator src/components/CodeEditor/engine/languages/http/http.grammar -o src/components/CodeEditor/engine/languages/http/parser.ts --typeScript",
    "publish:local": "pnpm build && yalc publish --push",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.figma.json",
    "test": "rstest watch",
    "test:coverage": "rstest run --coverage",
    "test:run": "rstest run",
    "storybook": "storybook dev --no-open -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:failed": "playwright test --last-failed",
    "e2e:failed:headed": "playwright test --last-failed --headed",
    "e2e:report": "playwright show-report",
    "e2e:docker": "playwright test --config=playwright.config.docker.ts",
    "e2e:docker:ui": "playwright test --config=playwright.config.docker.ts --ui",
    "e2e:docker:failed": "playwright test --config=playwright.config.docker.ts --last-failed",
    "e2e:docker:report": "playwright show-report ./playwright-report --port=9323"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@figma/code-connect": "1.5.3",
    "@internationalized/date": "3.12.4",
    "@lezer/generator": "1.8.1",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rslib/core": "catalog:",
    "@rstest/core": "catalog:",
    "@rstest/coverage-v8": "catalog:",
    "@shikijs/types": "4.5.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-router": "1.170.41",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/babel__core": "7.20.5",
    "@types/luaparse": "0.2.13",
    "@types/node": "catalog:",
    "@types/prismjs": "1.26.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wallarm-org/mcp-core": "workspace:*",
    "@wallarm-org/playwright-config": "workspace:*",
    "@wallarm-org/publish-scripts": "workspace:*",
    "@wallarm-org/rsbuild-config": "workspace:*",
    "@wallarm-org/rstest-config": "workspace:*",
    "@wallarm-org/tailwind-config": "workspace:*",
    "@wallarm-org/typescript-config": "workspace:*",
    "babel-plugin-react-compiler": "1.0.0",
    "glob": "13.0.6",
    "jsdom": "catalog:",
    "postcss": "8.5.28",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "storybook-react-rsbuild": "3.6.0",
    "tailwindcss": "catalog:",
    "ts-morph": "28.0.0",
    "tsx": "4.23.15",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.2",
    "@babel/parser": "7.29.9",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/json": "1.0.3",
    "@lezer/lr": "1.4.10",
    "@radix-ui/react-compose-refs": "1.1.5",
    "@radix-ui/react-slot": "1.3.3",
    "@react-aria/datepicker": "3.17.1",
    "@react-aria/i18n": "3.13.1",
    "@react-stately/datepicker": "3.17.1",
    "@react-types/datepicker": "3.14.0",
    "@react-types/shared": "3.36.1",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@zag-js/file-utils": "1.43.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "highlight.js": "11.12.0",
    "json-schema-library": "11.6.2",
    "luaparse": "0.3.1",
    "prism-react-renderer": "2.4.1",
    "prismjs": "1.30.0",
    "react-resizable-panels": "4.14.1",
    "recharts": "3.10.1",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0"
  }
}
