{
  "extends": "@wallarm-org/typescript-config/e2e.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "dist",
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": [
    "**/*.e2e.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "playwright.config.ts",
    "playwright.config.docker.ts"
  ],
  "exclude": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.figma.*",
    "**/__tests__/**",
    "**/stories/**",
    "**/story-content/**",
    "**/mocks.ts",
    "**/mocks.tsx",
    "**/mocks/**",
    "src/testUtils",
    "node_modules",
    "dist",
    "storybook-static"
  ]
}
