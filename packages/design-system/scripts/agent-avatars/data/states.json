      "STATES": 2176,
      "NO_APPS": 2177,
      "eyeTargets": 1565,
      "helloPop": 1578,
      "springs": 1560,
      "glyph": 2029,
      "setCover": 1801
    }
  },
  "states": [
    {
      "key": "idle",
      "label": "On duty",
      "product": "Active, waiting for work",
      "engine": "idle"
    },
    {
      "key": "hello",
      "label": "Hello",
      "product": "Chat or drawer opened",
      "engine": "hello"
    },
    {
      "key": "working",
      "label": "Working",
      "product": "Run in progress",
      "engine": "working"
    },
    {
      "key": "needs",
      "label": "Needs you",
      "product": "N pending approval",
      "engine": "needs"
    },
    {
      "key": "done",
      "label": "Done",
      "product": "Run finished, change applied",
      "engine": "done"
    },
    {
      "key": "failed",
      "label": "Failed",
      "product": "Run failed",
      "engine": "failed"
    },
    {
      "key": "off",
      "label": "Deactivated",
      "product": "Deactivated",
      "engine": "off"
    },
    {
      "key": "box",
      "label": "Not set up",
      "product": "Not set up",
      "engine": "box"
    },
    {
      "key": "invite",
      "label": "Inviting",
      "product": "Not set up, inviting",
      "engine": "invite"
    },
    {
      "key": "partly",
      "label": "Partial coverage",
      "product": "Active in some applications",
      "engine": "idle with the cover flag (setCover(true))"
    }
  ],
  "internal": {
    "power": "the landing after Activate, from box or invite; eyes use the box targets (invite targets when coming from invite) until the flicker at 800 ms; at 1150 ms it ends in idle, or in the state picked during the landing",
    "partly": "\"Partial coverage\" is not an engine state: it is idle plus a grey crown (setCover). It is offered only to agents that have applications."
  },
  "noPartialCoverage": [
    "wally",
    "trim"
  ],
