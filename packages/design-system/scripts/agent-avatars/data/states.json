  "springs": {
    "$about": "Spring presets as written in the source: SPR(T, zeta) with response time T in seconds and damping ratio zeta; k = (2 pi / T)^2, c = 2 zeta (2 pi / T). P_SHAPE moves eye shapes, P_POP the Hello and Done pops, P_DART fast gaze moves, P_PURSUIT cursor and steady gaze, P_BRIGHT brightness, P_SQ the hop squash, P_LAND the landing squash, P_W the motion weights (breathe, bob, float, work).",
    "values": {
      "P_SHAPE": {
        "T": 0.28,
        "zeta": 0.8
      },
      "P_POP": {
        "T": 0.32,
        "zeta": 0.45
      },
      "P_DART": {
        "T": 0.12,
        "zeta": 0.65
      },
      "P_PURSUIT": {
        "T": 0.3,
        "zeta": 0.85
      },
      "P_BRIGHT": {
        "T": 0.2,
        "zeta": 1
      },
      "P_SQ": {
        "T": 0.22,
        "zeta": 0.3
      },
      "P_LAND": {
        "T": 0.35,
        "zeta": 0.4
      },
      "P_W": {
        "T": 0.6,
        "zeta": 1
      }
    }
