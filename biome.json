{
  "$schema": "https://biomejs.dev/schemas/2.1.4/schema.json",
  "extends": ["./packages/configs/biome-config/biome.json"],
  "files": {
    "includes": [
      "**/src/**/*",
      "**/e2e/**/*.ts",
      "**/packages/**/*.ts",
      "**/packages/**/*.tsx",
      "**/packages/**/*.js",
      "**/packages/**/*.jsx",
      "**/apps/website/**/*.{ts,tsx}",
      "scripts/agents/**/*.mjs",
      ".claude/hooks/**/*.mjs",
      ".claude/settings.json",
      "**/*.d.ts",
      "**/*.css",
      "!**/src/theme/**/*.css",
      "*.config.ts",
      "**/.storybook/**/*",
      "*.json",
      "!**/dist",
      "!**/__fixtures__",
      "!**/node_modules",
      "!**/storybook-static",
      "!**/*.gen.ts",
      "!**/CodeEditor/engine/languages/http/parser.ts",
      "!**/CodeEditor/engine/languages/http/parser.terms.ts",
      "!**/playwright-report",
      "!**/coverage",
      "!**/doc_build",
      "!**/doc_build_local",
      "!**/.rspress",
      "!**/.claude-design",
      "!packages/claude-design/src/assets/cover.html"
    ]
  },
  "overrides": [
    {
      "includes": [
        "packages/claude-design/src/css/entry.css",
        "packages/design-system/.storybook/preview.css",
        "apps/website/styles/global.css"
      ],
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      }
    }
  ]
}
