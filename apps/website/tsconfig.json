{
  "extends": "@wallarm-org/typescript-config/react-app.json",
  "compilerOptions": {
    "types": ["node", "@rstest/core/globals"],
    "customConditions": ["development"],
    "allowJs": true,
    // customConditions pulls DS src into this program; Oxlint already flags unused code here.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "env.d.ts",
    "rspress.config.ts",
    "rstest.config.ts",
    "theme",
    "docs/**/*.ts",
    "docs/**/*.tsx",
    "scripts"
  ]
}
