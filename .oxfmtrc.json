{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "arrowParens": "avoid",
  "embeddedLanguageFormatting": "off",
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react/**"]
      }
    ],
    "groups": [
      "react",
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },
  "overrides": [
    {
      "files": ["**/*.css"],
      "options": {
        "tabWidth": 4
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/__fixtures__/**",
    "**/storybook-static/**",
    "**/*.gen.ts",
    "**/CodeEditor/engine/languages/http/parser.ts",
    "**/CodeEditor/engine/languages/http/parser.terms.ts",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/coverage/**",
    "**/doc_build/**",
    "**/doc_build_local/**",
    "**/.rspress/**",
    "**/src/theme/**/*.css",
    "**/*.md",
    "**/*.mdx",
    "**/*.yaml",
    "**/*.yml",
    "**/*.toml",
    "**/*.html",
    "**/*.svg",
    "**/CHANGELOG*"
  ],
  "sortTailwindcss": {
    "stylesheet": "./packages/design-system/.storybook/preview.css",
    "functions": ["cn", "clsx", "cva", "twMerge"]
  }
}
